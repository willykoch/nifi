      {
        "identifier": "8c860e50-19c9-4eca-ad6a-47b179ef6307",
        "instanceIdentifier": "d7a00869-d1d8-3d93-e1b6-466ea7a9fde6",
        "name": "Append CSV Log",
        "comments": "Appends one CSV row to /data/log/file-gateway-uploads.csv. Creates the header when the file is absent or empty.",
        "position": {
          "x": 2016.0,
          "y": 464.0
        },
        "type": "org.apache.nifi.processors.groovyx.ExecuteGroovyScript",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-groovyx-nar",
          "version": "2.12.0"
        },
        "properties": {
          "Script File": null,
          "Additional Classpath": null,
          "Script Body": "import java.nio.file.Files\nimport java.nio.file.Paths\nimport java.nio.file.StandardOpenOption\n\ndef flowFile = session.get()\nif (flowFile == null) return\n\ndef path = Paths.get('/data/inbound/log/file-gateway-uploads.csv')\ntry {\n    byte[] row = flowFile.read().bytes\n    Files.createDirectories(path.getParent())\n    if (!Files.exists(path) || Files.size(path) == 0) {\n        byte[] header = ('filename,sha256,http_status,http_message,uri' + System.lineSeparator()).getBytes('UTF-8')\n        Files.write(path, header, StandardOpenOption.CREATE, StandardOpenOption.APPEND)\n    }\n    byte[] newline = System.lineSeparator().getBytes('UTF-8')\n    byte[] line = new byte[row.length + newline.length]\n    System.arraycopy(row, 0, line, 0, row.length)\n    System.arraycopy(newline, 0, line, row.length, newline.length)\n    Files.write(path, line, StandardOpenOption.CREATE, StandardOpenOption.APPEND)\n    REL_SUCCESS << flowFile\n} catch (Exception e) {\n    log.error('Could not append upload row to CSV', e)\n    REL_FAILURE << flowFile\n}",
          "Failure Strategy": "transfer to failure"
        },
